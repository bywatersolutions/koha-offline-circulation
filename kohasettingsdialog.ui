<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>KohaSettingsDialog</class>
 <widget class="QDialog" name="KohaSettingsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>580</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Koha Connection Settings - Koha Offline Circulation</string>
  </property>
  <property name="modal">
   <bool>true</bool>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="groupBoxServer">
     <property name="title">
      <string>Koha Server</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutServer">
      <item>
       <layout class="QFormLayout" name="formLayoutServer">
        <property name="fieldGrowthPolicy">
         <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
        </property>
        <item row="0" column="0">
         <widget class="QLabel" name="labelBaseUrl">
          <property name="text">
           <string>Staff interface URL</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="lineEditBaseUrl">
          <property name="placeholderText">
           <string>https://koha-staff.example.org</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="labelUserid">
          <property name="text">
           <string>Username</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QLineEdit" name="lineEditUserid"/>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="labelPassword">
          <property name="text">
           <string>Password</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QLineEdit" name="lineEditPassword">
          <property name="echoMode">
           <enum>QLineEdit::Password</enum>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="labelPasswordNote">
        <property name="text">
         <string>Credentials are stored in the system keychain. Use a dedicated Koha account with minimal permissions.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxUseToken">
        <property name="text">
         <string>Use an API token instead of the password</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="formLayoutToken">
        <property name="fieldGrowthPolicy">
         <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
        </property>
        <item row="0" column="0">
         <widget class="QLabel" name="labelClientId">
          <property name="text">
           <string>Client ID</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="lineEditClientId"/>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="labelClientSecret">
          <property name="text">
           <string>Client secret</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QLineEdit" name="lineEditClientSecret">
          <property name="echoMode">
           <enum>QLineEdit::Password</enum>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="labelTokenNote">
        <property name="text">
         <string>Tokens work with the Koha plugin and REST API methods. Saved reports, and uploads without the plugin, use the username and password.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxMethod">
     <property name="title">
      <string>Connection method</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutMethod">
      <item>
       <widget class="QRadioButton" name="radioButtonPlugin">
        <property name="text">
         <string>Koha plugin (recommended)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="labelPluginNote">
        <property name="text">
         <string>Downloads the borrowers database the companion plugin builds nightly, and uploads go through the plugin too.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="indent">
         <number>20</number>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="radioButtonReports">
        <property name="text">
         <string>Saved reports</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="labelReportsNote">
        <property name="text">
         <string>Needs the two report IDs below and the catalogue permission.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="indent">
         <number>20</number>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="formLayoutReports">
        <property name="fieldGrowthPolicy">
         <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
        </property>
        <item row="0" column="0">
         <widget class="QLabel" name="labelBorrowersReport">
          <property name="text">
           <string>Borrowers report ID</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QSpinBox" name="spinBoxBorrowersReport">
          <property name="maximum">
           <number>999999</number>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="labelIssuesReport">
          <property name="text">
           <string>Issues report ID</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QSpinBox" name="spinBoxIssuesReport">
          <property name="maximum">
           <number>999999</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QRadioButton" name="radioButtonRest">
        <property name="text">
         <string>REST API</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="labelRestNote">
        <property name="text">
         <string>No server setup, needs the borrowers and circulate permissions.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="indent">
         <number>20</number>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxUpload">
     <property name="title">
      <string>Upload</string>
     </property>
     <layout class="QFormLayout" name="formLayoutUpload">
      <property name="fieldGrowthPolicy">
       <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
      </property>
      <item row="0" column="0">
       <widget class="QLabel" name="labelBranchcode">
        <property name="text">
         <string>Branch code</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="horizontalLayoutBranchcode">
        <item>
         <widget class="QComboBox" name="comboBoxBranchcode">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="editable">
           <bool>true</bool>
          </property>
          <property name="insertPolicy">
           <enum>QComboBox::NoInsert</enum>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="pushButtonFetchLibraries">
          <property name="text">
           <string>Fetch from Koha</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="1" column="1">
       <widget class="QLabel" name="labelLibrariesStatus">
        <property name="text">
         <string/>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="checkBoxUploadPending">
        <property name="text">
         <string>Queue uploads for staff review instead of processing immediately</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxAutomatic">
     <property name="title">
      <string>Automatic Downloads</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutAutomatic">
      <item>
       <layout class="QHBoxLayout" name="horizontalLayoutNightly">
        <item>
         <widget class="QCheckBox" name="checkBoxNightly">
          <property name="text">
           <string>Download nightly at</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QTimeEdit" name="timeEditNightly">
          <property name="displayFormat">
           <string>HH:mm</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="horizontalSpacerNightly">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxOnLaunch">
        <property name="text">
         <string>Download at startup if the database is older than 24 hours</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Save</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>KohaSettingsDialog</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>KohaSettingsDialog</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>
